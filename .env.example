# Where Postgres and the RSA keypair live ON THE MAC, outside Docker.
# Named volumes are stored inside Docker Desktop's VM image, which a
# Docker major upgrade can reset — that is how this database was lost once.
AIRLOCK_DATA_DIR="/Users/galen/Library/Application Support/ProjectAirlock"

# Postgres. With docker compose this is the container, published on
# 127.0.0.1 only. Keep POSTGRES_PASSWORD in step with it.
POSTGRES_PASSWORD="change-me-locally"
DATABASE_URL="postgresql://airlock:airlock_local@localhost:5432/clinical_notes?schema=public"

# Google Gemini API key (cloud formatting layer — only ever sees scrubbed text).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# LM Studio. Runs the local NER de-identification pass, and — when the
# clinician picks the Local option in the model selector — writes the note too.
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
# The model each request asks for. Leave it empty to follow whatever LM Studio
# actually has loaded; a stale pin means asking for a model that is not there.
LMSTUDIO_MODEL="local-model"
LMSTUDIO_TIMEOUT_MS="90000"
# The formatting pass writes a whole chart entry rather than a short entity
# list, so on a large local model it needs considerably longer than the NER
# pass. Kept under the route's 300s limit.
LMSTUDIO_FORMAT_TIMEOUT_MS="240000"

# Fail-closed policy. "false" = abort the request if the local NER pass is
# unavailable, so nothing unverified is ever shipped to Gemini.
ALLOW_DEGRADED_SCRUB="false"

# RSA keypair filename inside ./.keys/ (private key only; contains no PHI).
KEY_STORE_FILE="server-rsa.json"

# Optional: override the Gemini endpoint (egress proxy, regional endpoint, or a
# local stub for verification). Leave unset in normal operation.
# GEMINI_BASE_URL=""

# Optional: override the whole model ladder, best first, comma separated.
# Default ladder: 3.7/3.6/3.5/3/2.5 Flash, then the Flash Lite models, which
# carry 500 requests/day on the free tier against the flagships' 20.
# GEMINI_MODEL_LADDER=""

# Scratch database for `prisma migrate diff/dev`. Holds no application data.
SHADOW_DATABASE_URL="postgresql://airlock:airlock_local@localhost:5432/airlock_shadow"

# --- Google sign-in -----------------------------------------------------
# Create an OAuth 2.0 Client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add these redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://llm.galenchen.uk/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Random secret: `openssl rand -base64 32`
AUTH_SECRET=""
# Canonical URL of this instance (used to build OAuth callbacks).
AUTH_URL="http://localhost:3000"
# MANDATORY allowlist. Emails and/or @domains, comma separated.
# An empty list denies everyone — this app is reachable from the internet.
AUTH_ALLOWED_EMAILS="you@example.com,@yourhospital.org.tw"

# --- Developer bypass ---------------------------------------------------
# Password sign-in as `airlock_dev`, for working on the UI without Google.
# OFF by default and localhost-only: a short shared password on a tunnelled
# instance is not authentication. Turn both off before real patient use.
DEV_LOGIN_ENABLED="false"
DEV_LOGIN_PASSWORD="llm"
DEV_LOGIN_ALLOW_REMOTE="false"

# --- Cloudflare Tunnel (optional) ---------------------------------------
# From Zero Trust > Networks > Tunnels > Create a tunnel > Cloudflared.
# Then run:  docker compose --profile tunnel up -d
TUNNEL_TOKEN=""
