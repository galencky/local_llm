<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>uk.galenchen.airlock.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/galen/Desktop/local_llm/ops/backup-airlock.sh</string>
  </array>

  <!-- 23:59 daily. If the Mac is asleep, launchd runs it at next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>59</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AIRLOCK_DIR</key>
    <string>/Users/galen/Desktop/local_llm</string>
  </dict>

  <key>StandardErrorPath</key>
  <string>/Users/galen/Documents/airlock-backups/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
