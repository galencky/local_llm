# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts
/src/generated

# secrets and key material — never commit these
# .env holds the Gemini key, Google OAuth client secret, AUTH_SECRET and the
# Cloudflare tunnel token. .env.example is the template and IS tracked.
.env
.env.*
!.env.example
.keys/
*.pem
*.p12
*.key

# local database dumps (de-identified, but still not repo material)
*.sql.gz
/backups/

# editor / OS
.DS_Store
.idea/
.vscode/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tooling artefacts dropped in by `prisma init` — reference docs for AI
# assistants, not part of this project
/.agents/
/.windsurf/
/.claude/
skills-lock.json

# deploy
.vercel
